# Aqua Scope Backend Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Secret key used for signing session tokens and cryptographic operations
SECRET_KEY=your-secret-key-change-in-production

# Demo user credentials
DEMO_EMAIL=demo@aquascope.org
DEMO_PASSWORD=your-secure-password

# Database configuration
DB_PATH=aqua_users.db

# Server configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

